{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "composite": true
  },
  "include": ["vite.config.ts", "obfuscate.ts", "devCsp.ts", "vitest.config.ts", "playwright.config.ts", "e2e/target.ts", "e2e/load.ts"]
}
