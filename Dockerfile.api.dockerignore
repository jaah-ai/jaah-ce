# Dockerfile.api's build context is the public tree's root; it reads apps/api, toolchain/, the files it copies into
# ./shared and ./doctrine, and VERSION. Kept out: the secrets file and everything
# heavy.
.env
.git
**/node_modules
**/__pycache__
apps/web
apps/docs
# Except the event catalog Dockerfile.api copies into ./shared (the webhooks catalog reads it).
!apps/docs/reference-data/events.toml
apps/site-widget
